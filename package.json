{
  "name": "snackcheck",
  "private": true,
  "version": "0.0.0",
  "description": "Can I Bring This? — Arizona Healthy Schools Act food compliance checker",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:coverage": "pnpm --filter @snackcheck/compliance test:coverage",
    "test:integration": "pnpm --filter web test:integration",
    "test:e2e": "pnpm --filter web test:e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:types": "pnpm exec tsx scripts/generate-db-types.ts",
    "db:verify-seed": "pnpm exec tsx scripts/verify-seed.ts",
    "db:check-provenance": "pnpm exec tsx scripts/check-regulatory-provenance.ts",
    "check-ingredients": "pnpm exec tsx scripts/check-ingredients.ts"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
