# Public application URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — publishable values may be exposed to the browser.
# The service-role key must never be sent to the client.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# Phase 7 image transcription providers (server-only). Keep keys empty in
# production until the provider evaluation, budgets, and rollout are approved.
GEMINI_API_KEY=
GEMINI_PRIMARY_MODEL=gemini-3.5-flash-lite
GEMINI_ESCALATION_MODEL=gemini-3.7-flash
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.6-luna
OPENAI_EXTRACTION_PROMPT_VERSION=p7-v1
AI_EXTRACTION_KILL_SWITCH=true
AI_PROVIDER_TIMEOUT_MS=12000

# Open Food Facts exact-GTIN fallback (server-only). Autocomplete never uses this.
OPEN_FOOD_FACTS_ENABLED=true
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
OPEN_FOOD_FACTS_USER_AGENT=SnackCheck/0.1 (http://localhost:3000)
OPEN_FOOD_FACTS_CONTACT_EMAIL=

# Distributed rate limiting. Required in production before extraction is enabled.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# HMAC secret used to derive a daily rotating anonymous analytics key.
# Never store the raw IP.
ANONYMOUS_KEY_HMAC_SECRET=

# Signs anonymous submission ownership tokens (HTTP-only cookie).
SUBMISSION_TOKEN_SECRET=

# Optional error monitoring. Logging still works if unset.
SENTRY_DSN=
LOG_LEVEL=info

# Image pipeline limits
MAX_UPLOAD_BYTES=12582912
MAX_SANITIZED_IMAGE_BYTES=3145728
MAX_IMAGE_DIMENSION=2200
EXTRACTION_DAILY_LIMIT=200
EXTRACTION_CONFIDENCE_THRESHOLD=0.72

# Public feature flags. Keep production camera and photo flags false until explicitly enabled.
FEATURE_BARCODE_CAMERA=false
FEATURE_INGREDIENT_PHOTO=false
FEATURE_PHOTO_EXTRACTION=false
NEXT_PUBLIC_FEATURE_BARCODE_CAMERA=false
NEXT_PUBLIC_FEATURE_INGREDIENT_PHOTO=false
DEV_CATALOG_ENABLED=false
